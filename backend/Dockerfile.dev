FROM node:18-alpine

ARG POSTGRES_USER
ARG POSTGRES_PASSWORD
ARG POSTGRES_DB

# Checking env values
RUN echo "POSTGRES_USER = $POSTGRES_USER"
RUN echo "POSTGRES_PASSWORD = $POSTGRES_PASSWORD"
RUN echo "POSTGRES_DB = $POSTGRES_DB"

WORKDIR /usr/src/app

# Copy the code excluding file and folders in .dockerignore (node_modules, dist)
COPY app/package.json ./

# Sets up database connection string in the environment
# 
# During the build of the Dockerfile.dev, an .env file is created, but 
# Docker compose will remove it when mounting the app folder from host.
# Adding this .env file to the dockerignore seems to prevent that
# 
# Make sure to add this line to the .dockerignore file:
# 
# app/.env
# 
COPY ./app/.env.template /usr/src/app/.env

RUN sed -i "s|POSTGRES_USER|$POSTGRES_USER|g" ./.env
RUN sed -i "s|POSTGRES_PASSWORD|$POSTGRES_PASSWORD|g" ./.env
RUN sed -i "s|POSTGRES_DB|$POSTGRES_DB|g" ./.env

# Install npm packages
RUN npm install

# Initializes Prisma ORM
# RUN npm run prisma generate

# run server
EXPOSE 3000

# Debug is also watching for changes
CMD export PORT=3000 && npm run start:debug
